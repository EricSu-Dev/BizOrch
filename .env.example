BIZORCH_ENVIRONMENT=development
BIZORCH_DEBUG=false
BIZORCH_AUTH_SESSION_TTL_HOURS=8
BIZORCH_DATABASE_URL=mysql+pymysql://bizorch:change-me@127.0.0.1:3306/bizorch
BIZORCH_REDIS_URL=redis://127.0.0.1:6379/0
BIZORCH_CHROMA_PATH=./data/chroma
BIZORCH_KNOWLEDGE_UPLOAD_PATH=./data/uploads
BIZORCH_KNOWLEDGE_INDEX_POLL_INTERVAL_SECONDS=2
BIZORCH_KNOWLEDGE_INDEX_LEASE_SECONDS=300
BIZORCH_KNOWLEDGE_INDEX_RETRY_BASE_SECONDS=5
BIZORCH_CHECKPOINT_PATH=./data/checkpoints/langgraph.db
BIZORCH_ENTERPRISE_OPS_BASE_URL=http://127.0.0.1:8100
BIZORCH_ENTERPRISE_OPS_MCP_URL=http://127.0.0.1:8200/mcp
# Development-only pair; replace with two distinct random values in any shared environment.
BIZORCH_ENTERPRISE_OPS_MCP_READ_TOKEN=bizorch-development-mcp-read-token
BIZORCH_ENTERPRISE_OPS_MCP_ACTION_GATEWAY_TOKEN=bizorch-development-mcp-action-gateway-token
BIZORCH_DEEPSEEK_BASE_URL=https://api.deepseek.com
BIZORCH_DEEPSEEK_MODEL=deepseek-v4-flash
BIZORCH_OSS_BUCKET_NAME=
BIZORCH_OSS_ENDPOINT=
BIZORCH_OSS_ACCESS_KEY_ID=
BIZORCH_OSS_ACCESS_KEY_SECRET=
BIZORCH_OSS_AVATAR_PREFIX=bizorch/avatars
ENTERPRISE_DATABASE_URL=mysql+pymysql://bizorch_enterprise:change-me@127.0.0.1:3306/bizorch_enterprise
ENTERPRISE_INTERNAL_TOKEN=
BIZORCH_MCP_READ_TOKEN=
BIZORCH_MCP_ACTION_GATEWAY_TOKEN=

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
