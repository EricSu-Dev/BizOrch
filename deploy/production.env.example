# Copy to /opt/bizorch/.env, set mode 600, and replace every placeholder.
# Compose reads this file for interpolation, but compose.yaml passes each
# service only the explicit subset required by that process.

COMPOSE_PROJECT_NAME=bizorch
BIZORCH_DATA_DIR=/opt/bizorch/data
BIZORCH_LOG_DIR=/opt/bizorch/logs
BIZORCH_API_HOST_PORT=18000
BIZORCH_API_IMAGE=bizorch-api:2026.07.28-1
BIZORCH_ENTERPRISE_IMAGE=bizorch-enterprise:2026.07.28-1
BIZORCH_MCP_IMAGE=bizorch-enterprise-mcp:2026.07.28-1

BIZORCH_ENVIRONMENT=production
BIZORCH_DEBUG=false
BIZORCH_AUTH_SESSION_TTL_HOURS=8
BIZORCH_DATABASE_URL=mysql+pymysql://bizorch:replace-me@host.docker.internal:3306/bizorch
BIZORCH_REDIS_URL=redis://host.docker.internal:6379/0
BIZORCH_KNOWLEDGE_INDEX_POLL_INTERVAL_SECONDS=2
BIZORCH_KNOWLEDGE_INDEX_LEASE_SECONDS=300
BIZORCH_KNOWLEDGE_INDEX_RETRY_BASE_SECONDS=5
BIZORCH_DEEPSEEK_BASE_URL=https://api.deepseek.com
BIZORCH_DEEPSEEK_MODEL=deepseek-v4-flash

ENTERPRISE_DATABASE_URL=mysql+pymysql://bizorch_enterprise:replace-me@host.docker.internal:3306/bizorch_enterprise
ENTERPRISE_INTERNAL_TOKEN=replace-with-at-least-32-random-characters

DEEPSEEK_API_KEY=replace-me
DASHSCOPE_API_KEY=replace-me
BIZORCH_OSS_BUCKET_NAME=replace-me
BIZORCH_OSS_ENDPOINT=replace-me
BIZORCH_OSS_ACCESS_KEY_ID=replace-me
BIZORCH_OSS_ACCESS_KEY_SECRET=replace-me
BIZORCH_OSS_AVATAR_PREFIX=bizorch/avatars

# Online read-only evaluation hard limits. Keep these bounded on a 2GB server.
BIZORCH_EVALUATION_LIVE_MAX_CASES=20
BIZORCH_EVALUATION_LIVE_MAX_CALLS=40
BIZORCH_EVALUATION_LIVE_MAX_INPUT_TOKENS=200000
BIZORCH_EVALUATION_LIVE_MAX_OUTPUT_TOKENS=50000
BIZORCH_EVALUATION_LIVE_MAX_EMBEDDING_TEXTS=100
BIZORCH_EVALUATION_LIVE_CASE_TIMEOUT_SECONDS=60
BIZORCH_EVALUATION_LIVE_RUN_TIMEOUT_SECONDS=1200
